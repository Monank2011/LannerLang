main() i32:
    Mobile.log("Lanner mobile runtime test")
    p: string = Mobile.platform()
    os: string = Mobile.osVersion()
    appPath: string = Mobile.appDataPath()
    docPath: string = Mobile.documentsPath()
    cachePath: string = Mobile.cachePath()
    sim: bool = Mobile.isSimulator()
    camera: bool = Mobile.cameraAvailable()
    location: bool = Mobile.locationAvailable()
    bluetooth: bool = Mobile.bluetoothAvailable()
    width: i32 = Mobile.screenWidth()
    height: i32 = Mobile.screenHeight()
    scale: f64 = Mobile.deviceScale()
    top: i32 = Mobile.safeAreaTop()
    bottom: i32 = Mobile.safeAreaBottom()
    left: i32 = Mobile.safeAreaLeft()
    right: i32 = Mobile.safeAreaRight()
    opened: bool = Mobile.openUrl("https://lanner-lang.dev")
    vibration: bool = Mobile.vibrate(1)
    permission: i32 = Mobile.requestPermission("camera")
    copied: bool = Mobile.clipboardSet("lanner-mobile")
    clipboard: Buffer = Mobile.clipboardGet()
    text: string = clipboard.cstr()
    length: usize = clipboard.len()
    clipboard.free()
    if p.equals("") && os.equals("") && appPath.equals("") && docPath.equals("") && cachePath.equals("") && sim && camera && location && bluetooth && width < 0 && height < 0 && scale < 0.0 && top < 0 && bottom < 0 && left < 0 && right < 0 && opened && vibration && permission < -2 && !copied && length == 0 && text.equals("never"):
        return 99
    return 0
