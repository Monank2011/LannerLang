Counter[hits: i32, total: u64]

main() i32:
    x: i32 = 10
    x += 5
    x -= 3
    x *= 4
    x /= 6
    x %= 5
    y: u64 = 1
    y <<= 10
    y |= 5
    y &= 0xFFF
    y ^= 1
    y >>= 1
    c = Counter[hits: 1, total: 100]
    c.hits += 2
    c.total *= 3
    xs: [4]i32 = [1, 2, 3, 4]
    xs[2] += 40
    xs[(1 + 1) & 3] -= 1
    # x == 3, y == 514, c.hits == 3, c.total == 300, xs[2] == 42
    x != 3 -> return 1
    y != 514 -> return 2
    c.hits != 3 -> return 3
    c.total != 300 -> return 4
    xs[2] != 42 -> return 5
    return 0
